#!/usr/bin/env bash
# Sets up Claudexus in the current git repository. Never overwrites existing files.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"
git rev-parse --show-toplevel >/dev/null 2>&1 || git init -q
repo=$(git rev-parse --show-toplevel); name=$(basename "$repo"); today=$(date +%Y-%m-%d)

cd "$CLAUDEXUS_HOME/template"
find . -type f | sed 's|^\./||' | while IFS= read -r f; do
  if [ -e "$repo/$f" ]; then echo "kept   $f"; continue; fi
  mkdir -p "$repo/$(dirname "$f")"
  sed "s/{{PROJECT}}/$name/g; s/{{DATE}}/$today/g" "$f" > "$repo/$f"
  echo "added  $f"
done
for line in ".worktrees/" ".team/"; do
  grep -qxF "$line" "$repo/.gitignore" 2>/dev/null || echo "$line" >> "$repo/.gitignore"
done
cat <<MSG

Next:
  1. Claude fills AGENTS.md from your code.
  2. You: in the Codex app, open this project and start a new chat with exactly:
       Claudexus ↔ Codex · $name — shared work log. Reply "ready" only.
  3. Then run: claudexus link
MSG
