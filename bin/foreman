#!/usr/bin/env bash
# foreman — Claude Code leads, Codex works. Usage: foreman <init|link|task|usage|doctor> [args]
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  init|link|task|usage|doctor) exec "$here/foreman-$cmd" "$@" ;;
  *) cat <<USAGE
foreman — Claude Code leads, Codex works.

  foreman init                  set up Foreman in the current repository
  foreman link                  link the Codex-app chat you created for this repo
  foreman task <id> <brief.md> [medium|high|xhigh] [base-ref] [timeout-min]
                                hand a task to Codex in its own git worktree
  foreman usage                 Codex 5-hour and weekly usage
  foreman doctor                check requirements
USAGE
  ;;
esac
